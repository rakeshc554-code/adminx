graph LR
    subgraph Client[User Device - Secure Enclave]
        A[User Input] --> B(Presentation UI)
        B --> C{Business Logic}
        C --> D[Local SQLite]
        C --> E[On-Device AI]
        E --> F[SLM Model]
        D --> G[Sync Queue]
    end

    subgraph Network[Encrypted Tunnel - TLS 1.3]
        G --> H{Cloud Gateway}
    end

    subgraph Cloud[AdminX Cloud - Encrypted Storage]
        H --> I[Firebase Auth]
        H --> J[Firestore DB]
        H --> K[Backup Bucket]
        J --> L[External APIs]
        L --> M[WhatsApp/Twilio]
    end

    style Client fill:#e8eaf6,stroke:#1a237e
    style Network fill:#fff3e0,stroke:#e65100
    style Cloud fill:#e0f7fa,stroke:#006064