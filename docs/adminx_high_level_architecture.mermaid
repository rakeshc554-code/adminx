graph TB
    subgraph Presentation_Layer [Presentation Layer]
        Mobile[Android/iOS KMP]
        Web[Web React/KMP]
        Desktop[Desktop Win/Mac KMP]
    end

    subgraph Application_Layer [Shared Application Layer]
        BizLogic[Business Logic KMP]
        AIEngine[On-Device AI Engine]
        SyncClient[Sync Client]
    end

    subgraph Data_Layer [Data Layer]
        LocalDB[(SQLite Local)]
        AIModels[SLM Models<br>Phi-3/Llama]
        FileSystem[Local Storage]
    end

    subgraph Cloud_Layer [Cloud Infrastructure]
        Firebase[Firebase<br>Auth/Firestore/CM]
        BackupStore[(Backup Storage<br>GCS/S3)]
        External[External Services<br>WhatsApp API/Twilio]
    end

    Mobile --> BizLogic
    Web --> BizLogic
    Desktop --> BizLogic
    BizLogic --> LocalDB
    BizLogic --> AIEngine
    AIEngine --> AIModels
    SyncClient --> Firebase
    SyncClient --> BackupStore
    BizLogic --> External